FROM node:24-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build \
    && ./node_modules/.bin/esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js \
    && npm prune --omit=dev

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    OMNIROUTE_EMBEDDED=true \
    DATA_DIR=/tmp/omniroute \
    SQLITE_DB_PATH=/tmp/omniroute-edge.sqlite

RUN npm install --global omniroute@3.8.50 \
    && groupadd --system omniroute-edge \
    && useradd --system --gid omniroute-edge --home-dir /tmp/omniroute omniroute-edge \
    && mkdir -p /app /tmp/omniroute \
    && chown -R omniroute-edge:omniroute-edge /app /tmp/omniroute

WORKDIR /app
COPY --from=build --chown=omniroute-edge:omniroute-edge /app/package.json ./package.json
COPY --from=build --chown=omniroute-edge:omniroute-edge /app/node_modules ./node_modules
COPY --from=build --chown=omniroute-edge:omniroute-edge /app/dist ./dist
COPY --from=build --chown=omniroute-edge:omniroute-edge /app/server.js ./server.js

USER omniroute-edge
CMD ["node", "server.js"]
