# OmniRoute Edge local configuration
# Leave blank for offline/local snapshot mode. Set a real HTTPS OmniRoute origin in production.
OMNIROUTE_ORIGIN=
OMNIROUTE_ORIGIN_TOKEN=
PORT=3001
SQLITE_DB_PATH=sqlite.db
OMNIROUTE_REFERENCE_DB_PATH=OmniRoute-provider-reference.sqlite.db
ENVIRONMENT=local
# Optional local admin bootstrap values:
DEV_ADMIN_TOKEN=
BOOTSTRAP_SECRET=
GATEWAY_AUTH_TOKEN=
STORAGE_ENCRYPTION_KEY=

# Browser administrator authentication (DreamWorker entry flow)
# Use long random values. Do not commit real secrets.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=false

# Optional OAuth. Buttons remain disabled unless both client ID and client secret are configured.
AUTH_OAUTH_AUTO_PROVISION=false
AUTH_ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
